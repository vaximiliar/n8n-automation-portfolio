    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n\n  const message = (item.json.message || \"\").toLowerCase();\n\n  let priority = \"Cold\";\n  let reason = \"No high-priority keywords found.\";\n\n  if (\n    message.includes(\"urgent\") ||\n    message.includes(\"asap\") ||\n    message.includes(\"immediately\") ||\n    message.includes(\"today\") ||\n    message.includes(\"budget\") ||\n    message.includes(\"ready\")\n  ) {\n    priority = \"Hot\";\n    reason = \"Urgent request or buying intent detected.\";\n  } else if (\n    message.includes(\"automation\") ||\n    message.includes(\"quote\") ||\n    message.includes(\"interested\") ||\n    message.includes(\"help\") ||\n    message.includes(\"project\")\n  ) {\n    priority = \"Warm\";\n    reason = \"Potential customer showed interest.\";\n  }\n\n  item.json.priority = priority;\n  item.json.reason = reason;\n}\n\nreturn $input.all();"
      },
